<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tezgpt_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/open_drawer_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_secondary_button"
                android:contentDescription="@string/open_navigation"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_sort_by_size" />

            <TextView
                android:id="@+id/shell_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:text="TezGPT"
                android:textColor="@color/tezgpt_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/shell_new_chat_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_secondary_button"
                android:contentDescription="@string/new_chat"
                android:padding="10dp"
                android:src="@android:drawable/ic_input_add" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/shell_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navigation_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/tezgpt_surface"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="18dp"
            android:text="TezGPT"
            android:textColor="@color/tezgpt_green"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/nav_chat"
            style="@style/TezGPTDrawerButton"
            android:text="@string/chat" />
        <Button
            android:id="@+id/nav_conversations"
            style="@style/TezGPTDrawerButton"
            android:text="@string/conversations" />
        <Button
            android:id="@+id/nav_search"
            style="@style/TezGPTDrawerButton"
            android:text="@string/search" />
        <Button
            android:id="@+id/nav_agents"
            style="@style/TezGPTDrawerButton"
            android:text="@string/agents" />
        <Button
            android:id="@+id/nav_files"
            style="@style/TezGPTDrawerButton"
            android:text="@string/files" />
        <Button
            android:id="@+id/nav_memory"
            style="@style/TezGPTDrawerButton"
            android:text="@string/memory" />
        <Button
            android:id="@+id/nav_settings"
            style="@style/TezGPTDrawerButton"
            android:text="@string/settings" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/nav_logout"
            style="@style/TezGPTDrawerButton"
            android:text="@string/logout" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
